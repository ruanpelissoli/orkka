# Copy to .env (gitignored). With E2E_BASE_URL unset only the offline specs run (fake tracker,
# stub gh, bare remotes, the runner's tracker/commands CLI).

# ── The sandboxed Orkka (npm run stack:start) ──────────────────────────────
# Its address: stack:start runs `orkka.dll start --no-browser --port <this port>`. Pick a port
# nothing else uses — your own Orkka listens on 6750.
E2E_BASE_URL=http://127.0.0.1:6760
E2E_API_URL=http://127.0.0.1:6760
# A scratch folder for the sandbox: <dir>/home is its ORKKA_HOME, <dir>/screens the screenshots,
# <dir>/orkka-start.out what `start` printed. NEVER your real ~/.orkka.
E2E_LOCAL_SANDBOX=
# The app `./orkka start` runs. Default: this clone's Release build — build it once with
# `./orkka start` (`orkka.cmd start`), or `dotnet build src/Orkka -c Release` + `npm run build` in ui/.
# E2E_ORKKA_DLL=
# 1 = `./orkka stop` the sandbox when a run ends.
E2E_STACK_STOP_AFTER=0

# ── Offline runner-CLI specs ────────────────────────────────────────────────
# Workspace profile + ORKKA_HOME for `./orkka tracker …` / `commands …` (default .runs/orkka-home).
E2E_RUNNER_WORKSPACE=e2e
# E2E_RUNNER_HOME=

# ── Optional ────────────────────────────────────────────────────────────────
# Fixed port for the fake Jira/ADO server (0 = any free port).
E2E_FAKE_TRACKER_PORT=0
# Bare remotes, base folders, stub CLIs, clones (default .runs/scratch). The stack's git insteadOf
# rule points at <scratch>/remotes, so keep it stable between stack:start and the specs.
# E2E_SCRATCH_DIR=

# The sources the surface manifest / sync-check scan (default: this monorepo and its ui/).
# E2E_SRC_UI=
# E2E_SRC_API=
