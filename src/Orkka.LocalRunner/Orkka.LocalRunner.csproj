<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A library: the runner (and the CLI pieces it shares) runs inside the `orkka` process
         (src/Orkka), next to the web host. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Reported in the runner's Hello (RunnerHello.DaemonVersion) and the start banner. -->
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orkka.AgentRuntime\Orkka.AgentRuntime.csproj" />
    <ProjectReference Include="..\Orkka.LocalRunner.Contracts\Orkka.LocalRunner.Contracts.csproj" />
    <ProjectReference Include="..\Modules\Orkka.Modules.Projects.Contracts\Orkka.Modules.Projects.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <!-- Tracker tickets arrive as HTML (Jira renderedFields, Azure DevOps rich text); agents
         read markdown. Built on AngleSharp 1.5.2 (the same pin Documents carries). -->
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Terminal PTY internals (ShellResolver, Pty) are unit-tested directly. -->
    <InternalsVisibleTo Include="Orkka.Tests" />
    <InternalsVisibleTo Include="orkka" />
  </ItemGroup>

</Project>
