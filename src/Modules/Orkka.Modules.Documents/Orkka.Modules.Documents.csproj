<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orkka.Modules.Agents.Contracts\Orkka.Modules.Agents.Contracts.csproj" />
    <ProjectReference Include="..\Orkka.Modules.Documents.Contracts\Orkka.Modules.Documents.Contracts.csproj" />
    <ProjectReference Include="..\Orkka.Modules.Projects.Contracts\Orkka.Modules.Projects.Contracts.csproj" />
    <ProjectReference Include="..\Orkka.Modules.Tasks.Contracts\Orkka.Modules.Tasks.Contracts.csproj" />
    <ProjectReference Include="..\..\Orkka.SharedKernel\Orkka.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkka.Tests" />
    <InternalsVisibleTo Include="Orkka.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="QuestPDF" Version="2026.7.0" />
    <PackageReference Include="QuestPDF.Markdown" Version="1.50.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="HtmlToOpenXml.dll" Version="3.4.1" />
    <!-- Direct pin: HtmlToOpenXml's transitive AngleSharp 1.4.0 has a known mXSS vulnerability (GHSA-pgww-w46g-26qg) -->
    <PackageReference Include="AngleSharp" Version="1.5.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
