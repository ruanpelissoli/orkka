{
  "name": "orkka-ui",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @orkka/local-ui",
    "build": "npm run build --workspace @orkka/local-ui",
    "preview": "npm run preview --workspace @orkka/local-ui",
    "typecheck": "npm run typecheck --workspace @orkka/local-ui",
    "lint": "eslint .",
    "test": "npm run test --workspace @orkka/local-ui"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
